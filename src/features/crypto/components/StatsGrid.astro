---
import StatCard from "./StatCard.astro";
---
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-6 mb-12" id="stats-container">
    <StatCard label="Harga Saat Ini" id="display-price" icon="lucide:banknote" />
    <StatCard label="Market Cap" id="display-market-cap" icon="lucide:bar-chart-3" />
    <StatCard label="Volume (24h)" id="display-volume" icon="lucide:refresh-cw" />
    <StatCard label="Perubahan (24h)" id="display-change-24h" icon="lucide:trending-up" />
    <StatCard label="Perubahan (30d)" id="display-change-30d" icon="lucide:calendar" />
</div>

<script>
    import { $cryptoData, $currentCurrency, $isLoading } from '../stores';
    import { formatCurrency } from '../utils';

    const priceDisplay = document.getElementById('display-price');
    const marketCapDisplay = document.getElementById('display-market-cap');
    const volumeDisplay = document.getElementById('display-volume');
    const change24hDisplay = document.getElementById('display-change-24h');
    const change30dDisplay = document.getElementById('display-change-30d');

    function formatPercentage(value: number) {
        return (value > 0 ? '+' : '') + value.toFixed(2) + '%';
    }

    function updatePercentageStyle(el: HTMLElement | null, value: number) {
        if (!el) return;
        el.textContent = formatPercentage(value);
        el.classList.remove('text-green-500', 'text-red-500');
        el.classList.add(value >= 0 ? 'text-green-500' : 'text-red-500');
    }

    function toggleLoading(isLoading: boolean) {
        const ids = ['display-price', 'display-market-cap', 'display-volume', 'display-change-24h', 'display-change-30d'];
        
        ids.forEach(id => {
            const content = document.getElementById(id);
            const skeleton = document.getElementById(`${id}-skeleton`);
            
            if (isLoading) {
                if (content) content.classList.add('opacity-0');
                if (skeleton) skeleton.classList.remove('hidden');
            } else {
                if (content) content.classList.remove('opacity-0');
                if (skeleton) skeleton.classList.add('hidden');
            }
        });
    }

    $isLoading.subscribe((loading) => {
        toggleLoading(loading);
    });

    $cryptoData.subscribe((data) => {
        if (!data) return;

        const currency = $currentCurrency.get();
        const marketData = data.statsData.market_data;

        if (priceDisplay) priceDisplay.textContent = formatCurrency(marketData.current_price[currency.cgId], currency.code);
        if (marketCapDisplay) marketCapDisplay.textContent = formatCurrency(marketData.market_cap[currency.cgId], currency.code);
        if (volumeDisplay) volumeDisplay.textContent = formatCurrency(marketData.total_volume[currency.cgId], currency.code);
        
        updatePercentageStyle(change24hDisplay, marketData.price_change_percentage_24h);
        updatePercentageStyle(change30dDisplay, marketData.price_change_percentage_30d);
        
        // Ensure loading is turned off if data arrives
        toggleLoading(false);
    });
</script>
