---
import { currencies } from "../constants";
---
<div class="relative inline-block w-32">
    <select 
        id="currency-selector"
        class="appearance-none w-full bg-stone-900 text-stone-100 px-4 py-2 pr-8 rounded-lg border border-stone-800 focus:outline-none focus:ring-2 focus:ring-orange-500/50 transition-all cursor-pointer text-sm font-medium"
    >
        {currencies.map((curr) => (
            <option value={curr.code}>
                {curr.code}
            </option>
        ))}
    </select>
    <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-2 text-stone-500">
        <svg class="h-4 w-4 fill-current" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20">
            <path d="M9.293 12.95l.707.707L15.657 8l-1.414-1.414L10 10.828 5.757 6.586 4.343 8z"/>
        </svg>
    </div>
</div>
