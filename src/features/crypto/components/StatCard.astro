---
import { Icon } from 'astro-icon/components';
import Skeleton from './Skeleton.astro';

interface Props {
    label: string;
    id: string;
    icon: string;
}
const { label, id, icon } = Astro.props;
---
<div class="bg-stone-900 p-8 rounded-2xl border border-stone-800 shadow-xl group hover:border-orange-500/50 transition-all duration-300">
    <div class="flex items-center gap-3 mb-3">
        <div class="p-2 bg-stone-800 rounded-lg text-orange-500 group-hover:bg-orange-500 group-hover:text-stone-950 transition-colors">
            <Icon name={icon} class="size-4" />
        </div>
        <p class="text-stone-400 text-sm font-medium uppercase tracking-wider">{label}</p>
    </div>
    <div class="relative h-10">
        <h3 class="text-3xl font-bold opacity-0 transition-opacity duration-300" id={id}></h3>
        <div id={`${id}-skeleton`} class="absolute inset-0 block">
            <Skeleton class="h-full w-3/4" />
        </div>
    </div>
</div>
