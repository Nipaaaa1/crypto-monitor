---
interface Props {
    label: string;
    id: string;
}
const { label, id } = Astro.props;
---
<div class="bg-stone-900 p-8 rounded-2xl border border-stone-800 shadow-xl">
    <p class="text-stone-400 text-sm font-medium mb-1 uppercase tracking-wider">{label}</p>
    <h3 class="text-3xl font-bold" id={id}></h3>
</div>
