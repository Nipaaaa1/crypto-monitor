---
import { Icon } from 'astro-icon/components';
import { SUPPORTED_COINS } from "../constants";
---
<div class="relative inline-block w-40">
    <select 
        id="crypto-selector"
        class="appearance-none w-full bg-stone-900 text-stone-100 px-4 py-2 pr-10 rounded-lg border border-stone-800 focus:outline-none focus:ring-2 focus:ring-orange-500/50 transition-all cursor-pointer text-sm font-medium"
    >
        {SUPPORTED_COINS.map((coin) => (
            <option value={coin.id}>
                {coin.name} ({coin.symbol})
            </option>
        ))}
    </select>
    <div class="pointer-events-none absolute inset-y-0 right-3 flex items-center text-stone-500">
        <Icon name="lucide:chevron-down" class="w-4 h-4" />
    </div>
</div>

<script>
    import { $coinId } from '../stores';

    const cryptoSelector = document.getElementById('crypto-selector') as HTMLSelectElement;
    
    // Update store when selection changes
    cryptoSelector?.addEventListener('change', (e) => {
        const target = e.target as HTMLSelectElement;
        $coinId.set(target.value);
    });

    // Sync UI with store
    $coinId.subscribe((id) => {
        if (cryptoSelector && cryptoSelector.value !== id) {
            cryptoSelector.value = id;
        }
    });
</script>
