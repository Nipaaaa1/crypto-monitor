import CryptoSelector from "../features/crypto/components/CryptoSelector.astro";
import StatsGrid from "../features/crypto/components/StatsGrid.astro";
import MarketAnalysis from "../features/crypto/components/MarketAnalysis.astro";
---

<BaseLayout title="Crypto Monitor">
	<Header>
		<div class="flex gap-4">
			<CryptoSelector />
			<CurrencySelector />
		</div>
	</Header>

	<StatsGrid />

	<MarketAnalysis />
</BaseLayout>
